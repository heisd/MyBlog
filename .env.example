SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# 允许跨域访问的前端域名，多个用英文逗号隔开，不要带结尾斜杠。
# 支持 * 通配符：用 https://*.vercel.app 可一次性覆盖正式域名 + 所有 Vercel 预览域名。
CORS_ORIGIN=https://your-frontend-domain.vercel.app,https://*.vercel.app
SUPABASE_VIDEO_BUCKET=project-videos
# 封面图片上传用的 Storage 桶（不存在会自动创建）
SUPABASE_IMAGE_BUCKET=project-covers
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-random-secret
PORT=3000

# 在线留言（联系页）邮件发送配置
# 收件邮箱，留言会发送到这里（默认已是你的 QQ 邮箱）
CONTACT_TO=2284610019@qq.com

# 方式零（推荐·能给任意人发信且无需域名）：Brevo HTTP API。
# 在 brevo.com 注册 → 验证一个发件邮箱（如你的 QQ 邮箱）→ 拿 API Key 填这里。
# 配了 Brevo 会最优先使用；可给任意访客邮箱发信（注册验证码/留言）。
BREVO_API_KEY=
# 发件邮箱（必须是在 Brevo 验证过的发件人）；留空默认用 CONTACT_TO。
BREVO_SENDER=2284610019@qq.com
BREVO_SENDER_NAME=Heisd.Stark

# 方式一：Resend HTTP API。走 HTTPS，绕过 Render 免费版对 SMTP 端口的封锁。
# 注意：Resend 免费版没验证域名时只能发到你自己账号邮箱（给任意人发需验证域名）。
RESEND_API_KEY=re_your_api_key
# 发件地址。没有自有域名时用 onboarding@resend.dev（只能发到你的 Resend 账号邮箱）。
RESEND_FROM=MyBlog <onboarding@resend.dev>

# 方式二（备选）：SMTP。注意 Render 免费实例已封禁出站 SMTP 端口，需付费实例才可用。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
# 发件邮箱账号（通常为完整邮箱地址）
SMTP_USER=your-account@qq.com
# QQ 邮箱需使用「授权码」而不是登录密码
SMTP_PASS=your-smtp-authorization-code
# 发件显示地址，留空则默认使用 SMTP_USER
CONTACT_FROM=your-account@qq.com

# 访客访问门禁（注册/登录看项目）
# 验证码发信复用上面的 Resend/SMTP；给任意访客邮箱发信需在 Resend 验证自有域名。
# 人机验证：配了 Cloudflare Turnstile 密钥就用它，否则用内置轻量验证（无需第三方）。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI 助手（会员专享）：OpenAI 兼容的 Chat Completions 接口（OpenAI / DeepSeek / Kimi / 智谱 等）。
# 不配则助手显示“尚未配置”。LLM_BASE_URL 不要带结尾的 /chat/completions。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
