SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
CORS_ORIGIN=https://your-frontend-domain.vercel.app
SUPABASE_VIDEO_BUCKET=project-videos
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-random-secret
PORT=3000

# 在线留言（联系页）邮件发送配置
# 收件邮箱，留言会发送到这里（默认已是你的 QQ 邮箱）
CONTACT_TO=2284610019@qq.com
# SMTP 服务器，QQ 邮箱默认 smtp.qq.com:465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
# 发件邮箱账号（通常为完整邮箱地址）
SMTP_USER=your-account@qq.com
# QQ 邮箱需使用「授权码」而不是登录密码
SMTP_PASS=your-smtp-authorization-code
# 发件显示地址，留空则默认使用 SMTP_USER
CONTACT_FROM=your-account@qq.com
