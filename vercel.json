{
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/forum",
      "destination": "/forum.html"
    },
    {
      "source": "/space",
      "destination": "/space.html"
    },
    {
      "source": "/u/:username",
      "destination": "/user.html?u=:username"
    },
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/editor",
      "destination": "/editor.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/project/:id",
      "destination": "/project-detail.html?id=:id"
    }
  ]
}
